  "narrative": {
    "northStar": "Institutional Directness",
    "overview": "Nutricare is a calm, decisive institutional world: white and mineral-green surfaces, deep-green actions, charcoal type and professional food photography at meaningful scale. Restrained rounding and generous spacing keep rigor approachable without turning proof into spectacle.\n\nThe system gives clinics and schools equal visual weight. It shares the finish level of established collective-catering brands such as Compass Group France and Restalliance without borrowing their identities.",
    "keyCharacteristics": [
      "Direct hierarchy and factual, neutral proof language.",
      "Archivo throughout, with compact oversized headings.",
      "Decisive food photography balanced by quiet surfaces.",
      "Deep-green actions, mineral-green sections and restrained gold focus cues.",
      "Equivalent prominence for clinical and educational audiences."
    ],
    "rules": [
      { "name": "The Green Carries Meaning Rule", "body": "Deep green marks action, authority or audience context; it is not ambient decoration.", "section": "colors" },
      { "name": "The One-Family Rule", "body": "Use Archivo for every interface and editorial role; hierarchy comes from scale, weight and spacing.", "section": "typography" },
      { "name": "The Equal Audiences Rule", "body": "Clinic and school entry points receive identical area, hierarchy and interaction weight.", "section": "layout" },
      { "name": "The Selective Lift Rule", "body": "Elevate only decision surfaces and primary imagery; factual rows remain flat.", "section": "elevation" }
    ],
    "dos": [
      "Do use professional food photography at decisive scale with functional crops.",
      "Do keep claims factual and neutral; let composition and imagery carry confidence.",
      "Do preserve the light/dark token mapping and visible keyboard focus.",
      "Do give clinics and schools equal prominence."
    ],
    "donts": [
      "Don't accumulate generic cards when a flat list or separator communicates the content.",
      "Don't invent badges, metrics, certifications or testimonials.",
      "Don't use gold as a broad decorative accent.",
      "Don't copy competitor branding, layouts or visual signatures."
    ]
